# qarm-cc: compile a C program with Q-ARM's headers (qarm.h) for AArch64 (the default) or x86-64 Linux.
#
#   qarm-cc [--x86-64] [--auto | --auto-all | --auto-estimate] [--remarks] [compiler options] file.c ... -o program
#
# It adds -O1 (oracle functions must be leaf functions without vector code: docs/qarm_isa.md 5.5), the headers
# (-iquote <prefix>/include/qarm) and -lm, and picks the compiler: cc on a host of that architecture, else
# aarch64-linux-gnu-gcc or x86_64-linux-gnu-gcc. QARM_CC overrides it. Options given later win (-O2, ...).
#   --auto       the QArmAuto pass (docs/qarm_auto.md): search and minimum loops in QARM_AUTO functions go to the
#                coprocessor (QSEARCH, QMIN), and count and sum loops in QARM_ESTIMATE functions too, as estimates
#                (QCOUNT, QAMPEST). Needs clang; the pass is built for that clang's LLVM on first use
#                (llvm-N-dev and cmake), into ~/.cache/qarm, unless the installation has one
#   --auto-all   searches and minimums in every function, marked or not
#   --auto-estimate   every eligible loop, counts and sums included, marked or not
#   --remarks    what the pass did, did not, and could do (-Rpass=qarm-auto ...)
# Then: qarm-run ./program
set -e
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
PREFIX=$(cd "$(dirname "$self")/.." && pwd)
arch=aarch64 auto= remarks=
while [ $# -gt 0 ]; do
    case $1 in
        --x86-64|--x86_64) arch=x86_64; shift ;;
        --aarch64|--arm64) arch=aarch64; shift ;;
        --auto) auto=annotated; shift ;;
        --auto-all) auto=all; shift ;;
        --auto-estimate) auto=all-estimate; shift ;;
        --remarks) remarks=1; shift ;;
        -h|--help) sed -n '5,19p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) break ;;
    esac
done
host=$(uname -m)
[ "$host" = arm64 ] && host=aarch64

if [ -n "$auto" ]; then
    clang=${QARM_CLANG:-clang}
    command -v "$clang" >/dev/null 2>&1 || { echo "qarm-cc: --auto needs clang (QARM_CLANG)" >&2; exit 2; }
    v=$("$clang" -dumpversion | cut -d. -f1)
    plugin=${QARM_AUTO_PLUGIN:-}
    [ -z "$plugin" ] && [ -f "$PREFIX/lib/qarm/QArmAuto-llvm$v.so" ] && plugin=$PREFIX/lib/qarm/QArmAuto-llvm$v.so
    if [ -z "$plugin" ]; then
        cache=${XDG_CACHE_HOME:-$HOME/.cache}/qarm
        plugin=$cache/QArmAuto-llvm$v.so
        if [ ! -f "$plugin" ]; then
            cfg=
            for c in "llvm-config-$v" "/usr/lib/llvm-$v/bin/llvm-config" "/opt/homebrew/opt/llvm@$v/bin/llvm-config" \
                     "/opt/homebrew/opt/llvm/bin/llvm-config" "/usr/local/opt/llvm/bin/llvm-config" llvm-config; do
                if command -v "$c" >/dev/null 2>&1 && [ "$("$c" --version | cut -d. -f1)" = "$v" ]; then cfg=$c; break; fi
            done
            [ -n "$cfg" ] || { echo "qarm-cc: --auto: the pass is built for clang $v's LLVM: install llvm-$v-dev (or set QARM_AUTO_PLUGIN)" >&2; exit 2; }
            echo "qarm-cc: building the QArmAuto pass for LLVM $v (once, into $cache)" >&2
            build=$(mktemp -d)
            cmake -S "$PREFIX/share/qarm/compiler" -B "$build" -DCMAKE_BUILD_TYPE=Release -DLLVM_DIR="$("$cfg" --cmakedir)" >/dev/null
            cmake --build "$build" >/dev/null
            mkdir -p "$cache"
            cp "$build/QArmAuto.so" "$plugin"
            rm -rf "$build"
        fi
    fi
    set -- -fpass-plugin="$plugin" "$@"
    case $auto in all|all-estimate) set -- -Xclang -load -Xclang "$plugin" -mllvm -qarm-auto=$auto "$@" ;; esac
    [ -n "$remarks" ] && set -- -Rpass=qarm-auto -Rpass-missed=qarm-auto -Rpass-analysis=qarm-auto "$@"
    linking=1
    for a in "$@"; do case $a in -c|-S|-E|-emit-llvm) linking= ;; esac; done
    [ -n "$linking" ] && set -- "$@" "$PREFIX/share/qarm/compiler/qarm_auto.c"
    target=
    [ "$host" = "$arch" ] || target=--target=$arch-linux-gnu
    exec "$clang" $target -O1 -iquote "$PREFIX/include/qarm" "$@" -lm
fi

if [ -n "$QARM_CC" ]; then cc=$QARM_CC
elif [ "$host" = "$arch" ] && command -v cc >/dev/null 2>&1; then cc=cc
elif command -v "$arch-linux-gnu-gcc" >/dev/null 2>&1; then cc=$arch-linux-gnu-gcc
else
    printf 'qarm-cc: no C compiler for %s Linux: install gcc-%s-linux-gnu, or set QARM_CC\n' "$arch" \
        "$(echo $arch | tr _ -)" >&2
    exit 2
fi
exec $cc -O1 -iquote "$PREFIX/include/qarm" "$@" -lm
